{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "external_call_timeout_ms": 3000,
  "retry": {
    "max_retries": 3,
    "backoff_ms": 200
  },
  "concurrency_lock": {
    "mechanism": "sqlite-wal-busy-timeout",
    "timeout_ms": 5000
  },
  "logging": {
    "format": "json",
    "require_trace_id": true
  },
  "resource_release": {
    "connection_pool_close": true,
    "file_handle_close": true
  }
}
