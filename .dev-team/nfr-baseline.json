{
  "external_call_timeout_ms": 3000,
  "retry": {
    "max_attempts": 3,
    "backoff_ms": 500
  },
  "concurrency_lock": "optimistic_or_mutex",
  "logging": {
    "format": "json",
    "require_trace_id": true
  },
  "resource_release": [
    "abort_controllers",
    "event_listeners",
    "background_timers"
  ]
}
