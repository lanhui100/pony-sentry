{
  "external_call_timeout_ms": 3000,
  "console_api_timeout_ms": {
    "contract": ".dev-team/contract-console-timeout.md",
    "value": 8000,
    "min_margin_over_acquire_ms": 2000,
    "max_ms": 15000,
    "source_of_acquire_timeout": "crates/server/src/main.rs",
    "rationale": "external_call_timeout_ms=3000 约束的是本服务对外发起的调用（webhook/通知）；console_api_timeout_ms 约束的是控制台入站读请求（浏览器 -> 本服务），其超时必须大于服务端自身 PostgreSQL 池等待（acquire_timeout 3000ms，见 crates/server/src/main.rs:152）并留出网络/JSON 解析余量，否则浏览器 abort 会先于服务端 500 到达，把 DB 不可达误判为请求超时。两者适用边界不同，不可合并取值。"
  },
  "retry": {
    "max_attempts": 3,
    "backoff_ms": 500
  },
  "concurrency_lock": "optimistic_or_mutex",
  "logging": {
    "format": "json",
    "require_trace_id": true,
    "trace_id": "request_id"
  },
  "resource_release": [
    "abort_controllers",
    "event_listeners",
    "background_timers"
  ],
  "tailnet_trust": {
    "contract": ".dev-team/contract-tailnet-trust.md",
    "default_enabled": false,
    "default_cidrs": "100.64.0.0/10,fd7a:115c:a1e0::/48",
    "default_trusted_hosts": [],
    "enable_env": "CONSOLE_TAILNET_TRUST",
    "enable_values": ["1", "true", "on"],
    "kill_switch_env": "CONSOLE_TAILNET_TRUST=0",
    "cidrs_env": "CONSOLE_TAILNET_CIDRS",
    "hosts_env": "CONSOLE_TRUSTED_HOSTS",
    "proxied_header_gate": true,
    "proxied_headers": ["x-forwarded-for", "x-real-ip", "forwarded"],
    "host_allowlist_gate": true,
    "host_match_ignores_port_and_case": true,
    "empty_host_allowlist_disables_trust": true,
    "startup_warn_on_degraded_config": true,
    "trust_grants": "read_only_get",
    "csrf_exempt": false,
    "logging": {
      "format": "json",
      "fields": ["scope", "request_id", "trust_decision", "peer", "host"],
      "forbidden_fields": [
        "admin_token",
        "client_token",
        "session_token",
        "csrf_token",
        "authorization",
        "cookie"
      ]
    },
    "fail_closed": true
  }
}
