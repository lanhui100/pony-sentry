#!/usr/bin/env bash
# .meta/gates/pre-commit
# Tier 1 Gate: 本地极速轻量门禁 (< 2s)
# 职责：语法格式快速校验 + 敏感信息/密钥泄露扫描防护

set -euo pipefail

echo "==> [Gate 1/3] Running pre-commit lightweight hygiene & secret check..."

# 1. 代码格式检查
if cargo fmt --version >/dev/null 2>&1; then
    cargo fmt --all -- --check 2>/dev/null || true
fi

# 2. 敏感信息 / 硬编码密码与私钥扫描
STAGED_FILES=$(git diff --cached --name-only || git diff --name-only HEAD 2>/dev/null || true)

if [ -n "$STAGED_FILES" ]; then
    # 匹配常见明文敏感 pattern: private_key, postgresql password, api_token, slack/github/gitlab token
    PATTERN='password[[:space:]]*[:=][[:space:]]*['\''"][^'\''"]{8,}['\''"]|BEGIN (RSA|EC|OPENSSH|DSA) PRIVATE KEY|eyJ[a-zA-Z0-9_-]{20,}|(ghp_[a-zA-Z0-9]{36}|github_pat_[a-zA-Z0-9_]{82}|glpat-[a-zA-Z0-9-]{20}|xox[baprs]-[0-9a-zA-Z]{10,48})'
    SUSPICIOUS=$(git grep -EI "$PATTERN" \
      -- $STAGED_FILES 2>/dev/null | grep -v "\.meta/gates/pre-commit" | grep -v "example" | grep -v "REDACTED" | grep -v "tests/" | grep -v "pnpm-lock\.yaml" || true)

    if [ -n "$SUSPICIOUS" ]; then
        echo "❌ [FAIL] Detected potential hardcoded secrets or private keys in staged files:"
        echo "$SUSPICIOUS"
        echo "Please redact sensitive values or use Kubernetes Secret / environment variables instead!"
        exit 1
    fi
fi

echo "✅ [PASS] Pre-commit gate passed cleanly."
