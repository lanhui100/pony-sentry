# PonySentry 备份专用环境变量模板（systemd: /etc/pony-sentry/backup.env）
# 由 deploy/systemd/pony-sentry-backup.service 通过 EnvironmentFile 加载；
# DATABASE_URL 复用 /etc/pony-sentry/pony-sentry.env，此处不重复声明。

# age 收件人公钥（age1...）。对应私钥由运维离线保管，严禁入库/入镜像。
AGE_RECIPIENT=age1replaceme

# 备份落盘目录（默认 /var/backups/pony-sentry），其容量与磁盘配额由宿主管控。
BACKUP_DIR=/var/backups/pony-sentry
BACKUP_RETENTION_DAYS=14
