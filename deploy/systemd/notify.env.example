# PonySentry → 企业微信 relay 环境变量模板（systemd: /etc/pony-sentry/notify.env）
# 与 job_copilot 的 alert_notify 复用同一套企微 relay 凭据（ADR-003 §1）。
WX_WORK_EXTERNAL_API_URL=http://replace-with-wecom-relay/api/v1/send
WX_WORK_EXTERNAL_API_KEY=replace-me
WX_WORK_USER_ID=replace-me
NOTIFY_PORT=3091  # 3090 在 devserver 已被其它 node 服务占用
# 仅通知这些项目（逗号分隔）；留空=全部项目
NOTIFY_PROJECTS=job_copilot
