# PonySentry 服务端环境变量模板（systemd: /etc/pony-sentry/pony-sentry.env）
# 三环境（dev / preprod / production）差异只体现在取值，键名保持一致。

# ── 进程与存储 ──────────────────────────────────────────────────────────────
PORT=3000
# sqlite:///path/to/ponysentry.db?mode=rwc 或 postgresql://user:pass@host:port/db
DATABASE_URL=postgresql://job_copilot:<password>@127.0.0.1:30543/ponysentry
RUST_LOG=info,pony_sentry=debug

# ── 鉴权（契约 R10）────────────────────────────────────────────────────────
# CLIENT_TOKEN：写入端点（POST /api/v1/ingest、POST /api/v1/traces）凭证；
#               为空表示写入不鉴权（仅限隔离网络，生产必须非空）。
CLIENT_TOKEN=
# ADMIN_TOKEN：读接口与 PATCH 的静态 API 凭证，也是控制台登录时交换短期会话的凭据
# （未配置时回退 CLIENT_TOKEN；两者皆空 → 读/PATCH 503 fail-closed）。
ADMIN_TOKEN=

# ── 控制台服务端会话 ───────────────────────────────────────────────────────
# 会话有效期（秒）：最小 60、最大 86400；服务重启后全部会话失效。
CONSOLE_SESSION_TTL_SECS=28800
# 通过 HTTPS 反代暴露控制台时置 1；纯 tailnet HTTP 环境保持未设置/0。
CONSOLE_COOKIE_SECURE=0

# ── 通知（既有行为保持不变）────────────────────────────────────────────────
WEBHOOK_URL=http://127.0.0.1:9090

# ── Tailnet 可信对端（契约 .dev-team/contract-tailnet-trust.md，R-T1..R-T13）──
# 目的：控制台只经 tailnet 访问时，读接口免 admin token（GET/HEAD），浏览器零输入进控制台。
# 安全语义（改动前必读）：
#   * 默认关闭：只有 CONSOLE_TAILNET_TRUST 取 1/true/on（大小写不敏感）才生效；未设置或其它任何值
#     （0/false/off/空串/yes…）一律关闭，全部来源仍走 ADMIN_TOKEN/会话鉴权（R-T2/R-T4）。
#   * 信任只兑换「只读」：PATCH/POST/DELETE 仍需会话 Cookie + x-csrf-token，信任绝不跳过 CSRF（R-T7）。
#   * 双重门槛缺一不可（R-T13）：对端 ∈ CONSOLE_TAILNET_CIDRS **且** Host ∈ CONSOLE_TRUSTED_HOSTS；
#     任一不满足即 401。Host 白名单是 DNS rebinding 的唯一防线（Host: evil.example:3000 即使 CIDR 命中
#     也 401，R-T5c）。
#   * 代理头只拒不放：请求带 x-forwarded-for / x-real-ip 即失去免 token 资格（R-T5/R-T11，不取首 hop）。
#   * fail-closed：CIDR/Host 解析失败不崩溃，信任关闭 + 回退默认 CIDR + 启动 WARN（R-T8b）；
#     空白名单 = 信任恒不生效 + 启动 WARN（R-T5d）。
# 关闭方式：注释掉或置 CONSOLE_TAILNET_TRUST=0（kill switch）。
#
# 开关：1/true/on 开启；未设置 = 关闭（默认）
# CONSOLE_TAILNET_TRUST=1
# 可信对端网段（逗号分隔 CIDR）；未设置 → 100.64.0.0/10,fd7a:115c:a1e0::/48（Tailscale CGNAT + ULA）。
# 不要为了「方便」加 0.0.0.0/0 或公网段：那等于把管理读接口交给任何来源。
# CONSOLE_TAILNET_CIDRS=100.64.0.0/10,fd7a:115c:a1e0::/48
# Host 白名单（逗号分隔 host 或 host:port，比较忽略大小写与端口）；未设置/空串 → 信任恒不生效。
# 填控制台的 tailnet MagicDNS 域名或 tailnet IP，例如：
# CONSOLE_TRUSTED_HOSTS=devserver.taildb165c.ts.net,100.95.193.103
# 反代/隧道（nginx、ssh -L、kubectl port-forward）会引入代理头或改写 Host，此时请保持信任关闭，
# 改用 ADMIN_TOKEN 登录（fail-closed 是刻意设计，不是缺陷）。

# ── retention（契约 R11.1；每日分批清理 events/traces，issues 聚合永久保留）──
RETENTION_DAYS_EVENTS=180
RETENTION_DAYS_TRACES=90
# 置 1 关闭每日清理任务
RETENTION_DISABLED=0
# 置 1 只打印清理计划不删除（首次上线观察用）
RETENTION_DRY_RUN=0
