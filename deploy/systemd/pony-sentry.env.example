# PonySentry 服务端环境变量模板（systemd: /etc/pony-sentry/pony-sentry.env）
# 三环境（dev / preprod / production）差异只体现在取值，键名保持一致。

# ── 进程与存储 ──────────────────────────────────────────────────────────────
PORT=3000
# sqlite:///path/to/ponysentry.db?mode=rwc 或 postgresql://user:pass@host:port/db
DATABASE_URL=postgresql://job_copilot:<password>@127.0.0.1:30543/ponysentry
RUST_LOG=info,pony_sentry=debug

# ── 鉴权（契约 R10）────────────────────────────────────────────────────────
# CLIENT_TOKEN：写入端点（POST /api/v1/ingest、POST /api/v1/traces）凭证；
#               为空表示写入不鉴权（仅限隔离网络，生产必须非空）。
CLIENT_TOKEN=
# ADMIN_TOKEN：读接口与 PATCH 凭证（未配置时回退 CLIENT_TOKEN；两者皆空 → 读/PATCH 503 fail-closed）。
ADMIN_TOKEN=

# ── 通知（既有行为保持不变）────────────────────────────────────────────────
WEBHOOK_URL=http://127.0.0.1:9090

# ── retention（契约 R11.1；每日分批清理 events/traces，issues 聚合永久保留）──
RETENTION_DAYS_EVENTS=180
RETENTION_DAYS_TRACES=90
# 置 1 关闭每日清理任务
RETENTION_DISABLED=0
# 置 1 只打印清理计划不删除（首次上线观察用）
RETENTION_DRY_RUN=0
